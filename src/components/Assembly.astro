---
import AgentAssembly from "../react/AgentAssembly.jsx";

/**
 * The MidEarth mark, built from a field of luminous particles that
 * settle into shape (see src/react/AgentAssemblyScene.jsx). It is the
 * very first thing on the page — above the hero — so it starts already
 * mostly assembled (there's no filler section above it to scroll down
 * through, unlike the standalone demo it was adapted from) and scatters
 * apart as the visitor scrolls it out of view into the hero below.
 *
 * client:load, not client:visible — this section is above the fold, so
 * it should be there (not a placeholder) the moment the page can paint.
 */
---

<section class="ground-void assembly-section" aria-label="The Mid Earth mark">
  <div class="wrap-wide assembly-frame">
    <span class="assembly-word assembly-word-left display display-xxl" data-magnetic>Mid</span>

    <div class="assembly-mount">
      <AgentAssembly client:load />
      <noscript>
        <div class="assembly-fallback">
          <img src="/logo-assembly-source.png" alt="Mid Earth" width="220" height="200" />
        </div>
      </noscript>
    </div>

    <span class="assembly-word assembly-word-right display display-xxl" data-magnetic>Earth</span>
  </div>

  <p class="assembly-tag mono">Meet the AI that pays it's HUMAN.</p>
</section>

<style>
  .assembly-section {
    position: relative;
    overflow: hidden;
  }
  .assembly-frame {
    position: relative;
  }
  .assembly-mount {
    width: 100%;
    height: 100svh;
    max-height: 56rem;
  }
  .assembly-mount :global(.assembly),
  .assembly-mount :global(.ambly-canvas) {
    position: relative;
    width: 100%;
    height: 100%;
  }
  .assembly-mount :global(canvas) {
    display: block;
    width: 100% !important;
    height: 100% !important;
  }
  .assembly-fallback {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
  }
  .assembly-fallback img {
    width: auto;
    height: 60%;
    max-width: 80%;
  }

  .assembly-word {
    position: absolute;
    top: 50%;
    margin: 0;
    line-height: 1;
    pointer-events: none;
    z-index: 2;
    /* magnetic hover drift, see the script below */
    transform: translateY(-50%) translate3d(var(--mx, 0px), var(--my, 0px), 0);
  }
  .assembly-word-left {
    left: clamp(1rem, 4vw, 3rem);
  }
  .assembly-word-right {
    right: clamp(1rem, 4vw, 3rem);
    text-align: right;
  }
  /* Width-only, so it also fired for landscape phones (568-719px wide,
     320-430px tall) — stacking the two words in normal flow on top of a
     mount that's already exactly one viewport tall (100svh), pushing
     total section height to ~1.3-1.5x the viewport. Gated on height too
     now: a landscape phone keeps the overlay layout (no added height);
     only a genuinely narrow AND tall viewport (portrait phones) stacks. */
  @media (max-width: 720px) and (min-height: 560px) {
    .assembly-word {
      position: static;
      transform: none;
      display: block;
      text-align: center;
    }
    .assembly-word-right {
      text-align: center;
    }
  }
  @media (max-height: 480px) {
    .assembly-mount {
      max-height: 70vh;
    }
  }

  /* The company tagline — sized and coloured to be read at a glance, not
     a caption. Pulled up into the mount's own empty space below the mark
     (the mark is vertically centred in a 100svh box, so there's real
     room to close there) rather than left at the bottom of the section. */
  .assembly-tag {
    position: relative;
    z-index: 2;
    margin: -20vh 0 0;
    padding: 0 1.25rem clamp(2.5rem, 6vw, 4rem);
    text-align: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-variation-settings: "wdth" 105;
    font-size: clamp(1.4rem, 3.4vw, 2.5rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    background: var(--grad-brand-soft);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }
  /* The stacked mobile layout above already puts "Earth" in normal flow
     directly below the mount — pulling the tag up here would run it
     straight into that text instead of into empty space. */
  @media (max-width: 720px) and (min-height: 560px) {
    .assembly-tag {
      margin-top: 0.5rem;
      font-size: clamp(1.15rem, 5vw, 1.6rem);
    }
  }
</style>

<script>
  /* Magnetic hover, cinnamon.co.uk "IMAGINE"-style: each [data-magnetic]
     element drifts toward the cursor within a soft falloff radius and
     eases back to rest once the cursor moves away. Ports the effect
     from the standalone animation demo's App.jsx (there it ran as a
     React hook over refs; here it's the same per-frame decay-lerp over
     a plain querySelectorAll, matching how the rest of this site's
     progressive-enhancement motion runs — see Base.astro). Off entirely
     under reduced motion or on touch-only devices, where there's no
     hover to react to. */
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const canHover = window.matchMedia("(hover: hover) and (pointer: fine)").matches;

  if (!reduced && canHover) {
    const RADIUS = 240; // px — how far from an element's center the pull reaches
    const STRENGTH = 0.35;

    const state = Array.from(document.querySelectorAll<HTMLElement>("[data-magnetic]")).map((el) => ({
      el,
      tx: 0,
      ty: 0,
      targetX: 0,
      targetY: 0,
    }));

    if (state.length) {
      const handleMove = (e: PointerEvent) => {
        state.forEach((s) => {
          const rect = s.el.getBoundingClientRect();
          const dx = e.clientX - (rect.left + rect.width / 2);
          const dy = e.clientY - (rect.top + rect.height / 2);
          const dist = Math.hypot(dx, dy);
          if (dist < RADIUS) {
            const falloff = 1 - dist / RADIUS;
            s.targetX = dx * STRENGTH * falloff;
            s.targetY = dy * STRENGTH * falloff;
          } else {
            s.targetX = 0;
            s.targetY = 0;
          }
        });
      };
      const handleLeave = () => {
        state.forEach((s) => {
          s.targetX = 0;
          s.targetY = 0;
        });
      };
      window.addEventListener("pointermove", handleMove);
      window.addEventListener("pointerleave", handleLeave);

      // Unlike every other hand-rolled rAF loop in this codebase (Arena,
      // Network, Globe, the particle scene), this one used to run forever
      // regardless of visibility or whether it had actually settled —
      // gated the same way those already are, plus an idle-when-settled
      // check specific to this effect (nothing else here has a true "rest"
      // state to detect). `wake()` restarts it from whichever of the three
      // triggers needs it: the section re-entering view, the tab
      // refocusing, or a new pointer event arriving while idle.
      let visible = true;
      let rafId = 0;

      let last = performance.now();
      function tick(now: number) {
        rafId = 0;
        const dt = Math.min((now - last) / 1000, 0.05);
        last = now;
        let settled = true;
        state.forEach((s) => {
          s.tx += (s.targetX - s.tx) * Math.min(dt * 6, 1);
          s.ty += (s.targetY - s.ty) * Math.min(dt * 6, 1);
          s.el.style.setProperty("--mx", `${s.tx.toFixed(2)}px`);
          s.el.style.setProperty("--my", `${s.ty.toFixed(2)}px`);
          if (Math.abs(s.tx) > 0.01 || Math.abs(s.ty) > 0.01 || Math.abs(s.targetX) > 0.01 || Math.abs(s.targetY) > 0.01) {
            settled = false;
          }
        });
        if (visible && !settled) rafId = requestAnimationFrame(tick);
      }
      function wake() {
        if (visible && !rafId) rafId = requestAnimationFrame(tick);
      }

      const section = document.querySelector(".assembly-section");
      if (section && "IntersectionObserver" in window) {
        let intersecting = true;
        const update = () => {
          visible = intersecting && !document.hidden;
          if (visible) wake();
        };
        new IntersectionObserver(
          (entries) => {
            intersecting = entries[0].isIntersecting;
            update();
          },
          { threshold: 0.01 }
        ).observe(section);
        document.addEventListener("visibilitychange", update);
      }

      window.addEventListener("pointermove", wake);
      window.addEventListener("pointerleave", wake);
      rafId = requestAnimationFrame(tick);
    }
  }

  /* "Mid" is anchored a fixed distance from the frame's left edge, so its
     gap to the mark is whatever room its own (short) text leaves over.
     "Earth" was anchored the same fixed distance from the right edge —
     but being a longer word, that left a visibly smaller gap on its side.
     Rather than guess a matching CSS offset (the words are different
     widths, in a proportional font, at a responsive size — no fixed
     constant survives every viewport), measure Mid's real gap and mirror
     it: Earth's `right` becomes whatever value puts its own inner edge
     the same distance from centre as Mid's inner edge already sits.
     Mid itself is never touched. No-op on the sub-720px stacked layout,
     where the words aren't absolutely positioned at all.

     "Earth" being wider than "Mid" can make an exact mirror geometrically
     impossible at some viewport widths — the ideal value would push
     Earth's box past the frame's own right edge. Floored at 0 (flush to
     that edge, never past it): 0 is confirmed safe — the text itself
     stays fully visible right up to the frame boundary — whereas letting
     the raw negative value through would push part of "Earth" beyond the
     frame and into the section's `overflow: hidden`, clipping it. */
  function syncEarthGap() {
    const frame = document.querySelector(".assembly-frame");
    const mid = document.querySelector(".assembly-word-left");
    const earth = document.querySelector(".assembly-word-right");
    if (!(frame instanceof HTMLElement) || !(mid instanceof HTMLElement) || !(earth instanceof HTMLElement)) {
      return;
    }
    if (getComputedStyle(mid).position !== "absolute") {
      earth.style.right = ""; // stacked mobile layout — defer to the CSS default
      return;
    }
    const frameRect = frame.getBoundingClientRect();
    const midRect = mid.getBoundingClientRect();
    const earthRect = earth.getBoundingClientRect();
    const leftInset = midRect.left - frameRect.left; // Mid's own gap-defining inset, read back, not recomputed
    const rightInset = leftInset + midRect.width - earthRect.width;
    earth.style.right = `${Math.max(0, rightInset)}px`;
  }

  syncEarthGap(); // an immediate, likely-correct pass (fonts are often already cached)
  Promise.resolve(document.fonts && document.fonts.ready).then(syncEarthGap); // then refine once fonts truly settle

  let gapResizeScheduled = false;
  window.addEventListener("resize", () => {
    if (gapResizeScheduled) return;
    gapResizeScheduled = true;
    requestAnimationFrame(() => {
      gapResizeScheduled = false;
      syncEarthGap();
    });
  });
</script>
