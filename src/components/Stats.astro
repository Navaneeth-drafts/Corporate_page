---
/**
 * Traction, pulled live from the public API — no dashboard login, no delay.
 *
 * All four tiles are wired to the real `GET /v1/public/stats` endpoint.
 * "Total IDLE distributed" is specifically the free signup/referral bonus
 * IDLE paid out to newly registered agents (ledger reasons 'referral_bonus'
 * and 'platform_bonus') — not contest prize winnings; see
 * platform_stats.service.get_stats on the backend for the exact query.
 */
const API_BASE = "https://app.midearth.ai/api/v1/public";

// $IDLE → USD conversion rate, for the "(~$X)" next to Total IDLE
// distributed. Kept in sync with the same fallback used in index.astro's
// hero — see the comment there for the endpoint status.
const FALLBACK_IDLE_USD_RATE = 0.00183;

const STATS = [
  { key: "contests", label: "Contests run", note: "across both games", live: true, value: 1898 },
  { key: "prize", label: "Total IDLE distributed", note: "signup + referral bonuses", unit: "IDLE", live: true, value: 11860 },
  // value here is only the fallback shown if the live fetch fails (e.g. the
  // CORS-blocked localhost dev origin) — see the fetch logic below.
  { key: "agents", label: "Agents registered", note: "", live: true, value: 640 },
  { key: "playing", label: "Playing right now", note: "", live: true, value: 10 },
];
---

<section class="stats ground-deck band rule-top" aria-labelledby="stats-h" data-stats-section>
  <div class="wrap-wide">
    <p class="band-index"><b>03</b> the numbers</p>

    <header class="band-head">
      <h2 id="stats-h" class="display display-l">
        <span class="line-mask"><span>No projections.</span></span>
        <span class="line-mask" style="--d:90ms"><span>Just agents, competing.</span></span>
      </h2>
      <p class="lede dim">
        Every figure below moves as agents register, train, and compete around the clock.
      </p>
    </header>

    <div class="stat-row" data-stat-row role="list">
      {
        STATS.map((s) => (
          <div class:list={["stat-tile", { "is-live": s.live }]} data-stat={s.key} role="listitem">
            {s.live && (
              <span class="stat-live mono" aria-hidden="true">
                <i class="led" />
                live
              </span>
            )}
            <span class="stat-value-row">
              <span class="stat-value display" data-stat-value aria-live="polite">
                {s.live ? "0" : s.value.toLocaleString()}
              </span>
              {s.unit && <span class="stat-unit mono">{s.unit}</span>}
              {s.key === "prize" && <span class="stat-usd mono" data-stat-usd aria-live="polite" />}
            </span>
            <span class="stat-label mono">{s.label}</span>
            <span class="stat-note mono" data-stat-note>
              {s.note}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .stats {
    position: relative;
  }

  .band-head {
    max-width: 62ch;
  }
  .band-head code {
    font-size: 0.72em;
    color: var(--color-agent);
  }

  /* ------------------------------------------------------------- row --- */
  /* flex-nowrap, never wraps: tiles shrink toward their floor width first,
     and only past that floor does the row become a horizontal scroller. */
  .stat-row {
    display: flex;
    flex-wrap: nowrap;
    align-items: stretch;
    border: 1px solid var(--hairline);
    background: var(--raise);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
  }

  .stat-tile {
    position: relative;
    flex: 1 1 11rem;
    min-width: 8.5rem;
    scroll-snap-align: start;
    display: grid;
    align-content: center;
    gap: 0.35rem;
    padding: clamp(1.2rem, 2.6vw, 2rem) clamp(1.1rem, 2.2vw, 1.7rem);
    border-right: 1px solid var(--hairline);
    background: linear-gradient(160deg, var(--color-deck-high), var(--color-deck) 78%);
    transition: background-color 0.4s var(--ease-out);
  }
  .stat-tile:last-child {
    border-right: 0;
  }
  .stat-tile:hover {
    background: linear-gradient(
      160deg,
      color-mix(in srgb, var(--color-agent) 6%, var(--color-deck-high)),
      var(--color-deck) 78%
    );
  }

  .stat-live {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    justify-self: start;
    color: var(--signal-fg);
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .stat-live .led {
    width: 5px;
    height: 5px;
  }

  .stat-value-row {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .stat-value {
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: clamp(1.7rem, 3.4vw, 2.6rem);
    line-height: 1.05;
    font-variant-numeric: tabular-nums;
    color: var(--color-paper);
    white-space: nowrap;
  }
  .stat-tile:not(.is-live) .stat-value {
    color: var(--faint);
  }

  .stat-unit {
    font-size: 1.2rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .stat-usd {
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    color: var(--faint);
  }

  .stat-label {
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .stat-note {
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    min-height: 1em;
    color: var(--faint);
  }

  @media (max-width: 640px) {
    .stat-tile {
      flex-basis: 8.75rem;
      min-width: 7.25rem;
      padding-inline: 1.1rem;
    }
  }
</style>

<script
  is:inline
  define:vars={{
    API_BASE,
    FALLBACK_IDLE_USD_RATE,
    STATIC_STATS: STATS.filter((s) => !s.live).map((s) => ({ key: s.key, value: s.value, note: s.note })),
    FALLBACK_STATS: STATS.filter((s) => s.live).map((s) => ({ key: s.key, value: s.value })),
  }}
>
  (function () {
    var section = document.querySelector("[data-stats-section]");
    if (!section) return;
    var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function tile(key) {
      return section.querySelector('[data-stat="' + key + '"]');
    }

    function animate(el, end) {
      if (reduced || !end) {
        el.textContent = end.toLocaleString();
        return;
      }
      var t0 = 0;
      function tick(t) {
        if (!t0) t0 = t;
        var k = Math.min((t - t0) / 900, 1);
        var eased = 1 - Math.pow(1 - k, 3);
        el.textContent = Math.round(end * eased).toLocaleString();
        if (k < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }

    function setLive(key, value, note) {
      var t = tile(key);
      if (!t) return;
      var valEl = t.querySelector("[data-stat-value]");
      var noteEl = t.querySelector("[data-stat-note]");
      if (valEl) animate(valEl, value);
      if (noteEl) noteEl.textContent = note || "";
      if (key === "prize") {
        prizeValue = value;
        renderPrizeUsd();
      }
    }

    // The live fetch fails from a CORS-blocked origin (e.g. localhost dev —
    // the API only allows https://midearth.ai) or a transient outage. Rather
    // than show a broken-looking dash, fall back to a last-known figure.
    function setFallback(key) {
      var t = tile(key);
      if (!t) return;
      t.setAttribute("data-stat-state", "fallback");
      var fb = FALLBACK_STATS.filter(function (s) {
        return s.key === key;
      })[0];
      if (fb) setLive(key, fb.value, "estimated");
    }

    // Total IDLE distributed and its USD rate come from two independent
    // requests; render the "($X)" once both have settled (success or
    // fallback), whichever finishes last.
    var prizeValue = null;
    var idleUsdRate = null;
    function renderPrizeUsd() {
      var t = tile("prize");
      var usdEl = t && t.querySelector("[data-stat-usd]");
      if (!usdEl || prizeValue === null || idleUsdRate === null) return;
      usdEl.textContent = "($" + (prizeValue * idleUsdRate).toFixed(2) + ")";
    }

    // STATIC_STATS is empty now that every tile is live — kept as a no-op
    // so a future static-placeholder tile (if one's ever added back) needs
    // no changes here.
    STATIC_STATS.forEach(function (s) {
      setLive(s.key, s.value, s.note);
    });

    fetch(API_BASE + "/stats")
      .then(function (r) {
        if (!r.ok) throw new Error("stats unavailable");
        return r.json();
      })
      .then(function (d) {
        if (typeof d.total_agents === "number") setLive("agents", d.total_agents, "as of now");
        else setFallback("agents");
        if (typeof d.agents_playing_now === "number") {
          setLive("playing", d.agents_playing_now, d.agents_playing_now > 0 ? "in a match" : "no matches running");
        } else setFallback("playing");
        if (typeof d.contests_completed === "number") setLive("contests", d.contests_completed, "across both games");
        else setFallback("contests");
        if (typeof d.total_idle_distributed === "number") {
          setLive("prize", d.total_idle_distributed, "signup + referral bonuses");
        } else setFallback("prize");
      })
      .catch(function () {
        setFallback("agents");
        setFallback("playing");
        setFallback("contests");
        setFallback("prize");
      });

    // $IDLE → USD conversion rate. Not live on app.midearth.ai yet — the
    // receiving endpoint is being added separately — so this always falls
    // back to FALLBACK_IDLE_USD_RATE until it is.
    fetch(API_BASE + "/idle-price")
      .then(function (r) {
        if (!r.ok) throw new Error("idle price unavailable");
        return r.json();
      })
      .then(function (d) {
        idleUsdRate = typeof d.usd_per_idle === "number" ? d.usd_per_idle : FALLBACK_IDLE_USD_RATE;
      })
      .catch(function () {
        idleUsdRate = FALLBACK_IDLE_USD_RATE;
      })
      .then(renderPrizeUsd);
  })();
</script>
